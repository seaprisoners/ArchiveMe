# Copy values into your hosting provider's secret manager, or export them in your shell.
# Node does not automatically read this file. For local testing: node --env-file=.env src/index.js
DISCORD_BOT_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
DISCORD_CLIENT_SECRET=replace-with-oauth-client-secret
BASE_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
# Only for a same-machine reverse proxy you control:
TRUST_PROXY=loopback
DATABASE_PATH=./data/archiveme.sqlite
RETENTION_DAYS=90
